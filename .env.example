# ---- Backend ----
# Optional absolute path to the SQLite database file.
# Leave empty to use backend/jobs.db
DATABASE_PATH=

# ---- Job sources ----
# Adzuna API (free tier, US + CA). Get app_id + key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API (free, official US gov jobs). Get a key at https://developer.usajobs.gov
USAJOBS_API_KEY=

# ---- AI validation layer (choose ONE free option below) ----
# The AI layer removes junk emails (example.com, noreply@, trackers, etc.) and
# extracts name + company. It works with any OpenAI-compatible API.

# Option A - OpenAI (paid, needs credits): gpt-4o-mini is fractions of a cent.
# OPENAI_API_KEY=sk-...

# Option B - Groq (FREE tier): https://console.groq.com/keys
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...

# Option C - Google Gemini (FREE tier): https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# AI_API_KEY=AIza...

# Option D - OpenRouter (has free models): https://openrouter.ai/keys
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-...

# Optional overrides (not needed if you use the presets above)
# AI_MODEL=
# AI_BASE_URL=

# Serper.dev key for real Google search results (optional). If empty, the tool
# falls back to DuckDuckGo web search (free, no key needed).
SERPER_API_KEY=

# Google Custom Search JSON API (free, 100 queries/day) - the recommended search backend.
# Get a CSE id at https://cse.google.com/cse and an API key at
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=

# ---- Frontend ----
# Base URL of the backend API (dev only, used by the vite dev server).
# In production the built SPA is served by the same server, so this can be left unset.
VITE_API_URL=http://127.0.0.1:8000
